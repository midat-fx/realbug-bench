#!/usr/bin/env bash
# realbug-bench driver.
#
#   ./bench check [task...]           grade every solution of every task, compare with the expected verdict
#   ./bench verify <task> <patch>     grade one patch, print the verdict
#   ./bench workspace <task> <dir>    create the agent workspace: upstream at the base commit + visible tests
#   ./bench agent <task> <agent>      run a coding agent (claude|codex) on a task, grade its diff
#   ./bench report                    markdown table of every agent run in results/agents
#   ./bench build <task>              build the task image
#
# Expected verdicts come from file names: reference.patch and ok-*.patch must PASS, evil-*.patch must FAIL.
# --hostname localhost: without a network the container hostname does not resolve, and testsuite services bind to it.
# RUNS (default 2) repeats the whole check to catch flaky verdicts. PRUNE=1 removes each task image after use.
# Agent runs: AGENT_TIMEOUT (seconds, default 1800) caps a run; KEEP_WORKSPACE=1 keeps the agent's workspace.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
RUNS="${RUNS:-2}"
DOCKER_RUN_FLAGS=(--rm --network none --hostname localhost --cpus "${GRADE_CPUS:-2}" --memory "${GRADE_MEMORY:-4g}")

die() { echo "error: $*" >&2; exit 2; }
task_dir() { [ -f "$ROOT/tasks/$1/task.env" ] || die "unknown task $1"; echo "$ROOT/tasks/$1"; }
image() { echo "realbug-bench/$1:latest"; }
all_tasks() { for d in "$ROOT"/tasks/*/task.env; do basename "$(dirname "$d")"; done; }

build() {
	local dir base; dir=$(task_dir "$1")
	# A task may build FROM a shared base image (images/<name>), built once and kept by PRUNE.
	base=$(sed -n 's/^BASE_IMAGE=//p' "$dir/task.env")
	if [ -n "$base" ] && ! docker image inspect "$base" >/dev/null 2>&1; then
		docker build -q -t "$base" "$ROOT/images/$(sed -n 's/^BASE_IMAGE_DIR=//p' "$dir/task.env")" >/dev/null
	fi
	docker build -q -t "$(image "$1")" "$dir" >/dev/null
}

# verify <task> <patch> [log]  -> prints "PASS <layer>" / "FAIL <layer>"
verify() {
	local task=$1 patch=$2 log=${3:-/dev/stderr} dir out
	dir=$(task_dir "$task")
	patch=$(cd "$(dirname "$patch")" && pwd)/$(basename "$patch")
	out=$(docker run "${DOCKER_RUN_FLAGS[@]}" \
		-v "$patch:/in/candidate.patch:ro" \
		-v "$dir/task.env:/task/task.env:ro" \
		-v "$dir/tests:/task/tests:ro" \
		-v "$ROOT/harness/grade.sh:/grade.sh:ro" \
		"$(image "$task")" bash /grade.sh 2>&1) || true
	printf '%s\n' "$out" >"$log"
	local line; line=$(grep '^VERDICT ' <<<"$out" | tail -1)
	[ -n "$line" ] || { echo "ERROR no-verdict"; return; }
	echo "${line#VERDICT }"
}

expected() {
	case "$(basename "$1")" in
	reference.patch | ok-*.patch) echo PASS ;;
	evil-*.patch) echo FAIL ;;
	*) die "cannot infer expected verdict for $1" ;;
	esac
}

check() {
	local tasks=("$@") failed=0 task
	# shellcheck disable=SC2207
	[ $# -gt 0 ] || tasks=($(all_tasks))
	mkdir -p "$ROOT/results/logs"
	for task in "${tasks[@]}"; do
		echo "### $task"
		build "$task"
		for patch in "$(task_dir "$task")"/solutions/*.patch; do
			local name want verdicts=() v
			name=$(basename "$patch" .patch)
			want=$(expected "$patch")
			for run in $(seq 1 "$RUNS"); do
				v=$(verify "$task" "$patch" "$ROOT/results/logs/$task.$name.run$run.log")
				verdicts+=("$v")
			done
			local first=${verdicts[0]} status=ok
			for v in "${verdicts[@]}"; do [ "${v%% *}" = "${first%% *}" ] || status=FLAKY; done
			[ "$status" = ok ] && [ "${first%% *}" != "$want" ] && status=WRONG
			[ "$status" = ok ] || failed=1
			printf '  %-36s expect %-4s got %-28s [%s]\n' "$name" "$want" "$(IFS=,; echo "${verdicts[*]}")" "$status"
		done
		# PRUNE=1: drop the task image and build cache after grading (disk-constrained hosts)
		if [ "${PRUNE:-0}" = 1 ]; then
			docker rmi -f "$(image "$task")" >/dev/null
			docker builder prune -af >/dev/null
			docker image prune -f >/dev/null
		fi
	done
	return $failed
}

workspace() {
	local task=$1 ws=$2 dir
	dir=$(task_dir "$task")
	# shellcheck disable=SC1091
	(source "$dir/task.env"
		[ ! -e "$ws" ] || die "$ws already exists"
		git clone --quiet "$UPSTREAM" "$ws"
		git -C "$ws" checkout --quiet -B task "$BASE_COMMIT"
		# test-data submodules the suites need (task.env SUBMODULES), as in the task image
		# shellcheck disable=SC2086
		[ -z "${SUBMODULES:-}" ] || git -C "$ws" submodule update --quiet --init --depth 1 $SUBMODULES
		git -C "$ws" remote remove origin
		cp -R "$dir/tests/visible/." "$ws/"
		git -C "$ws" add -A
		git -C "$ws" -c user.email=bench@local -c user.name=bench commit --quiet -m "visible tests")
}

# Diff of everything the agent changed, including new files, against the workspace commit.
workspace_diff() {
	git -C "$1" add -A
	git -C "$1" diff --cached --binary HEAD
}

agent() {
	local task=$1 who=$2 dir stamp ws out model
	case "$who" in claude) model=${CLAUDE_MODEL:-claude-opus-5-5} ;; codex) model=${CODEX_MODEL:-} ;; esac
	dir=$(task_dir "$task")
	mkdir -p "$ROOT/results/agents/$task"
	# one directory per run; runs of the same task in parallel must not share one
	while :; do
		stamp=$(date -u +%Y%m%dT%H%M%SZ)
		out="$ROOT/results/agents/$task/$who${model:+-${model#claude-}}-$stamp"
		mkdir "$out" 2>/dev/null && break
		sleep 1
	done
	# no trailing slash: macOS TMPDIR has one, and a "//" path would slip past the transcript sanitizer
	ws="${AGENT_WORKDIR:-${TMPDIR:-/tmp}}"
	ws="${ws%/}/realbug-${out##*/}-$task"
	workspace "$task" "$ws"
	local prompt
	prompt="You are working in a $(. "$dir/task.env"; echo "$LANGUAGE" | sed 's/^go$/Go/;s/^cpp$/C++/;s/^python$/Python/;s/^typescript$/TypeScript/') repository. Resolve the following GitHub issue by changing the code.
Do not modify existing tests to make them pass. Visible tests are in the repository; hidden tests will also be run.

$(cat "$dir/issue.md")"
	local start end rc=0
	# perl alarm: a wall-clock cap without GNU timeout (not on macOS); a timed-out run exits 142
	local cap=(perl -e 'alarm shift; exec @ARGV' "${AGENT_TIMEOUT:-1800}")
	start=$(date +%s)
	case "$who" in
	claude)
		# project-only settings, no MCP servers, no skills: the agent sees the workspace and the issue only
		(cd "$ws" && "${cap[@]}" claude -p "$prompt" --model "$model" --permission-mode bypassPermissions \
			--setting-sources project --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
			--disable-slash-commands --no-session-persistence \
			--output-format stream-json --verbose </dev/null >"$out/transcript.jsonl" 2>"$out/stderr.log") || rc=$?
		;;
	codex)
		# no sandbox: the Go toolchain needs its build cache outside the workspace (same latitude as claude above)
		(cd "$ws" && "${cap[@]}" "${CODEX_BIN:-codex}" exec ${model:+-m "$model"} --dangerously-bypass-approvals-and-sandbox \
			--skip-git-repo-check --json "$prompt" >"$out/transcript.jsonl" 2>"$out/stderr.log") || rc=$?
		;;
	*) die "unknown agent $who" ;;
	esac
	end=$(date +%s)
	workspace_diff "$ws" >"$out/candidate.patch"
	build "$task"
	local verdict
	verdict=$(verify "$task" "$out/candidate.patch" "$out/grade.log")
	# contamination check: the agent must not have read this repository (hidden tests, solutions)
	if grep -q "realbug-bench/tasks" "$out"/transcript.* 2>/dev/null; then verdict="$verdict (CONTAMINATED)"; fi
	# shareable copy of the transcript: workspace and home paths replaced
	sed -e "s#/private$ws#\$WORKSPACE#g; s#$ws#\$WORKSPACE#g; s#$HOME#\$HOME#g" "$out/transcript.jsonl" | gzip -9n >"$out/transcript.jsonl.gz"
	# turns, cost and tokens from Claude Code's final stream-json event (null for other agents)
	local usage='{}'
	[ "$who" != claude ] || usage=$(jq -c 'select(.type == "result")
		| {turns: .num_turns, cost_usd: .total_cost_usd, is_error,
		   output_tokens: .usage.output_tokens, cache_read_tokens: .usage.cache_read_input_tokens}' \
		"$out/transcript.jsonl" 2>/dev/null | tail -1)
	jq -cn --arg task "$task" --arg agent "$who" --arg model "${model:-default}" --arg started "$stamp" \
		--argjson seconds $((end - start)) --argjson agent_exit "$rc" --arg verdict "$verdict" --argjson usage "${usage:-{\}}" \
		'{$task, $agent, $model, $started, $seconds, $agent_exit, $verdict} + $usage' | tee "$out/result.json"
	[ "${KEEP_WORKSPACE:-0}" = 1 ] || rm -rf "$ws"
}

# One row per agent run, oldest first.
report() {
	echo "| Task | Model | Verdict | Time | Turns | Cost (USD) | Run |"
	echo "|---|---|---|---|---|---|---|"
	for f in "$ROOT"/results/agents/*/*/result.json; do
		jq -r --arg run "${f#"$ROOT"/}" '[.started, "| `\(.task)` | \(.model) | \(.verdict) | \(.seconds / 60 | floor) min \(.seconds % 60) s | \(.turns // "—") | \(if .cost_usd then (.cost_usd * 100 | round / 100) else "—" end) | [\($run | split("/")[3])](\($run | rtrimstr("/result.json"))) |"] | @tsv' "$f"
	done | sort | cut -f2-
}

cmd=${1:-}
shift || true
case "$cmd" in
check) check "$@" ;;
verify) [ $# -eq 2 ] || die "usage: bench verify <task> <patch>"; build "$1"; verify "$1" "$2" ;;
workspace) [ $# -eq 2 ] || die "usage: bench workspace <task> <dir>"; workspace "$1" "$2" ;;
agent) [ $# -eq 2 ] || die "usage: bench agent <task> <claude|codex>"; agent "$1" "$2" ;;
report) report ;;
build) build "$1" ;;
*) sed -n '2,12p' "$0"; exit 2 ;;
esac
