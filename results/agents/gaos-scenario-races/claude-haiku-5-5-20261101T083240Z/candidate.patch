@@ -0,0 +1,70 @@
+package runner
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+)
+
+func newConcurrencyTestRunner() *Runner {
+	r := &Runner{}
+	r.Metrics.endpointCallCounts = map[string]int{}
+	return r
+}
+
+func TestMethodHandlerIsRaceFreeWhileDirectSwitchesScenario(t *testing.T) {
+	limited := &Scenario{Name: "limited", Rate: 3}
+	limited.executables = []Executable{NewRate(*limited).Execute}
+	other := &Scenario{Name: "other"}
+
+	limited.Accept = Action{Direct: "other", scenario: other, Status: 200, Result: Result{Type: ResultTypeStatic, Content: map[string]interface{}{"a": 1}}}
+	other.Accept = Action{Direct: "limited", scenario: limited, Status: 200, Result: Result{Type: ResultTypeStatic, Content: map[string]interface{}{"b": 2}}}
+
+	method := &Method{Scenario: *limited, runner: newConcurrencyTestRunner()}
+	handler := method.Handler()
+
+	var wg sync.WaitGroup
+	for c := 0; c < 32; c++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 50; i++ {
+				ctx := &fasthttp.RequestCtx{}
+				ctx.Request.SetRequestURI("http://localhost/path")
+				handler(ctx)
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestLimitIsExactUnderConcurrency(t *testing.T) {
+	const limit = 100
+	limiter := NewLimit(Scenario{Limit: limit})
+	var accepted int64
+	var wg sync.WaitGroup
+	for i := 0; i < 1000; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if _, err := limiter.Execute(); err == nil {
+				atomic.AddInt64(&accepted, 1)
+			}
+		}()
+	}
+	wg.Wait()
+
+	sequential := NewLimit(Scenario{Limit: limit})
+	var want int64
+	for i := 0; i < 1000; i++ {
+		if _, err := sequential.Execute(); err == nil {
+			want++
+		}
+	}
+
+	if accepted != want {
+		t.Fatalf("limit %d over 1000 concurrent calls accepted %d, sequential accepted %d", limit, accepted, want)
+	}
+}
