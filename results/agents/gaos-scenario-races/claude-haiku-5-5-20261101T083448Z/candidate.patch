@@ -0,0 +1,87 @@
+package runner
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+)
+
+func rejectedSequentially(exec Executable, calls int) int64 {
+	var rejected int64
+	for i := 0; i < calls; i++ {
+		if _, err := exec(); err != nil {
+			rejected++
+		}
+	}
+	return rejected
+}
+
+func rejectedConcurrently(exec Executable, calls int) int64 {
+	var rejected int64
+	var wg sync.WaitGroup
+	for i := 0; i < calls; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if _, err := exec(); err != nil {
+				atomic.AddInt64(&rejected, 1)
+			}
+		}()
+	}
+	wg.Wait()
+	return rejected
+}
+
+func TestLimitMatchesSequentialUnderConcurrency(t *testing.T) {
+	for _, limit := range []int{1, 2, 7, 100} {
+		want := rejectedSequentially(NewLimit(Scenario{Limit: limit}).Execute, 300)
+		got := rejectedConcurrently(NewLimit(Scenario{Limit: limit}).Execute, 300)
+		if got != want {
+			t.Errorf("limit %d: rejected %d concurrently, want %d", limit, got, want)
+		}
+	}
+}
+
+func TestRateMatchesSequentialUnderConcurrency(t *testing.T) {
+	for _, rate := range []int{1, 2, 5, 50} {
+		want := rejectedSequentially(NewRate(Scenario{Rate: rate}).Execute, 300)
+		got := rejectedConcurrently(NewRate(Scenario{Rate: rate}).Execute, 300)
+		if got != want {
+			t.Errorf("rate %d: rejected %d concurrently, want %d", rate, got, want)
+		}
+	}
+}
+
+func TestMethodHandlerConcurrentWithDirectSwitch(t *testing.T) {
+	r := &Runner{
+		Scenario: map[string]*Scenario{
+			"a": {Name: "a", Rate: 2, Accept: Action{Direct: "b", Status: fasthttp.StatusOK}},
+			"b": {Name: "b", Limit: 5, Accept: Action{Direct: "a", Status: fasthttp.StatusOK}},
+		},
+		Metrics: Metrics{endpointCallCounts: map[string]int{}},
+	}
+	r.resolveScenarios()
+
+	m := &Method{Scenario: *r.Scenario["a"], runner: r}
+	handler := m.Handler()
+
+	const requests = 200
+	var wg sync.WaitGroup
+	for i := 0; i < requests; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			var ctx fasthttp.RequestCtx
+			ctx.Request.Header.SetMethod(fasthttp.MethodGet)
+			ctx.Request.SetRequestURI("/path")
+			handler(&ctx)
+		}()
+	}
+	wg.Wait()
+
+	if got := r.Metrics.GetEndpointCallCount(fasthttp.MethodGet, "/path"); got != requests {
+		t.Fatalf("endpoint call count %d, want %d", got, requests)
+	}
+}
