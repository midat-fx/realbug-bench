@@ -0,0 +1,29 @@
+package runner
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+)
+
+func TestMethodDirectConcurrent(t *testing.T) {
+	a := &Scenario{Name: "a", Rate: 1, Accept: Action{Status: 200}, Ignore: Action{Status: 500}}
+	b := &Scenario{Name: "b", Limit: 5, Accept: Action{Status: 200}, Ignore: Action{Status: 500}}
+	a.Accept.scenario, a.Ignore.scenario = b, b
+	b.Accept.scenario, b.Ignore.scenario = a, a
+	a.executables = []Executable{NewRate(*a).Execute}
+	b.executables = []Executable{NewLimit(*b).Execute}
+	r := &Runner{}
+	r.Metrics.endpointCallCounts = map[string]int{}
+	h := (&Method{Scenario: *a, runner: r}).Handler()
+	var wg sync.WaitGroup
+	for i := 0; i < 200; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			h(&fasthttp.RequestCtx{})
+		}()
+	}
+	wg.Wait()
+}
