@@ -0,0 +1,27 @@
+package runner
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestMethodExecuteDirectConcurrent(t *testing.T) {
+	a := &Scenario{Name: "a"}
+	b := &Scenario{Name: "b"}
+	rb := NewRate(Scenario{Rate: 1})
+	b.executables = []Executable{rb.Execute}
+	a.Accept = Action{scenario: b}
+	b.Accept = Action{scenario: a}
+	b.Ignore = Action{scenario: a}
+	m := &Method{Scenario: *a, runner: &Runner{}}
+	var wg sync.WaitGroup
+	for i := 0; i < 200; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			m.Execute()
+			_ = m.name()
+		}()
+	}
+	wg.Wait()
+}
