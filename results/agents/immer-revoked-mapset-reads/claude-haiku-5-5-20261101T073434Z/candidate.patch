@@ -20,4 +20,61 @@ describe("revoked map and set drafts", () => {
 		})
 		expect(() => leaked.size).toThrow()
 	})
+
+	test("every map read throws after revocation, empty or modified", () => {
+		for (const modify of [false, true]) {
+			let leaked
+			produce({map: new Map(modify ? [["a", 1]] : [])}, draft => {
+				if (modify) draft.map.set("b", 2)
+				leaked = draft.map
+			})
+			expect(() => leaked.size).toThrow()
+			expect(() => leaked.has("a")).toThrow()
+			expect(() => leaked.get("a")).toThrow()
+			expect(() => leaked.set("a", 1)).toThrow()
+			expect(() => leaked.delete("zzz")).toThrow()
+			expect(() => leaked.clear()).toThrow()
+			expect(() => leaked.keys()).toThrow()
+			expect(() => leaked.values()).toThrow()
+			expect(() => leaked.entries()).toThrow()
+			expect(() => leaked[Symbol.iterator]()).toThrow()
+			expect(() => leaked.forEach(() => {})).toThrow()
+		}
+	})
+
+	test("every set read throws after revocation, empty or modified", () => {
+		for (const modify of [false, true]) {
+			let leaked
+			produce({set: new Set(modify ? [1] : [])}, draft => {
+				if (modify) draft.set.add(2)
+				leaked = draft.set
+			})
+			expect(() => leaked.size).toThrow()
+			expect(() => leaked.has(1)).toThrow()
+			expect(() => leaked.add(3)).toThrow()
+			expect(() => leaked.delete(1)).toThrow()
+			expect(() => leaked.delete(999)).toThrow()
+			expect(() => leaked.clear()).toThrow()
+			expect(() => leaked.keys()).toThrow()
+			expect(() => leaked.values()).toThrow()
+			expect(() => leaked.entries()).toThrow()
+			expect(() => leaked[Symbol.iterator]()).toThrow()
+			expect(() => leaked.forEach(() => {})).toThrow()
+		}
+	})
+
+	test("produce returns plain, usable collections", () => {
+		const base = {map: new Map([["a", 1]]), set: new Set([1])}
+		const next = produce(base, draft => {
+			draft.map.set("b", 2)
+			draft.set.add(2)
+		})
+		expect(next.map).toBeInstanceOf(Map)
+		expect(next.set).toBeInstanceOf(Set)
+		expect(next.map.size).toBe(2)
+		expect([...next.map.keys()]).toEqual(["a", "b"])
+		expect([...next.set]).toEqual([1, 2])
+		expect(next.map.constructor).toBe(Map)
+		expect(next.set.constructor).toBe(Set)
+	})
 })
