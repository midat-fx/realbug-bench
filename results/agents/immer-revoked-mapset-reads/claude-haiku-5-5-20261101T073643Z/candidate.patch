diff --git a/__tests__/revoked-map-set.js b/__tests__/revoked-map-set.js
index cae3016..18f2916 100644
--- a/__tests__/revoked-map-set.js
+++ b/__tests__/revoked-map-set.js
@@ -20,4 +20,73 @@ describe("revoked map and set drafts", () => {
 		})
 		expect(() => leaked.size).toThrow()
 	})
+
+	test("every map read throws after revocation, empty or modified", () => {
+		for (const modify of [false, true]) {
+			for (const entries of [[], [["a", 1]]]) {
+				let leaked
+				produce({map: new Map(entries)}, draft => {
+					if (modify) draft.map.set("b", 2)
+					leaked = draft.map
+				})
+				expect(() => leaked.get("a")).toThrow()
+				expect(() => leaked.has("a")).toThrow()
+				expect(() => leaked.size).toThrow()
+				expect(() => leaked.keys()).toThrow()
+				expect(() => leaked.values()).toThrow()
+				expect(() => leaked.entries()).toThrow()
+				expect(() => leaked[Symbol.iterator]()).toThrow()
+				expect(() => leaked.forEach(() => {})).toThrow()
+				expect(() => leaked.delete("missing")).toThrow()
+				expect(() => leaked.set("a", 3)).toThrow()
+				expect(() => leaked.clear()).toThrow()
+			}
+		}
+	})
+
+	test("every set read throws after revocation, empty or modified", () => {
+		for (const modify of [false, true]) {
+			for (const values of [[], [1]]) {
+				let leaked
+				produce({set: new Set(values)}, draft => {
+					if (modify) draft.set.add(2)
+					leaked = draft.set
+				})
+				expect(() => leaked.has(1)).toThrow()
+				expect(() => leaked.size).toThrow()
+				expect(() => leaked.values()).toThrow()
+				expect(() => leaked.keys()).toThrow()
+				expect(() => leaked.entries()).toThrow()
+				expect(() => leaked[Symbol.iterator]()).toThrow()
+				expect(() => leaked.forEach(() => {})).toThrow()
+				expect(() => leaked.delete("missing")).toThrow()
+				expect(() => leaked.add(3)).toThrow()
+				expect(() => leaked.clear()).toThrow()
+			}
+		}
+	})
+
+	test("live drafts behave as before and results are plain Maps and Sets", () => {
+		const result = produce(
+			{map: new Map([["a", 1]]), set: new Set([1])},
+			draft => {
+				expect(draft.map.has("a")).toBe(true)
+				expect(draft.map.size).toBe(1)
+				expect([...draft.map.keys()]).toEqual(["a"])
+				expect(draft.map.delete("missing")).toBe(false)
+				draft.map.set("b", 2)
+				expect(draft.set.size).toBe(1)
+				draft.set.add(2)
+				expect(draft.set.delete(3)).toBe(false)
+			}
+		)
+		expect(result.map).toBeInstanceOf(Map)
+		expect(result.map.constructor).toBe(Map)
+		expect([...result.map]).toEqual([
+			["a", 1],
+			["b", 2]
+		])
+		expect(result.set.constructor).toBe(Set)
+		expect([...result.set]).toEqual([1, 2])
+	})
 })
