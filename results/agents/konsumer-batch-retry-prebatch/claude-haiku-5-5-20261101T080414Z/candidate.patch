+			deadLetterMessages = append(deadLetterMessages, *msg)
+			continue
+		}
+
+		if retryErr == nil {
+			retryErr = consumeErr
+			if msg.ErrDescription != "" {
+				retryErr = errors.New(msg.ErrDescription)
+			}
+		}
 	}
-	return err
+
+	if len(deadLetterMessages) > 0 {
+		if err := b.sendDirectToDeadLetter(deadLetterMessages); err != nil {
+			return err
+		}
+	}
+
+	return retryErr
+}
+
+func (b *batchConsumer) sendDirectToDeadLetter(messages []Message) error {
+	if b.deadLetterProducer == nil {
+		return errors.New("no dead letter producer configured for SendDirectToDeadLetter message")
+	}
+
+	if err := b.sendToDeadLetterWithBackoff(messages...); err != nil {
+		return fmt.Errorf("error producing messages to dead letter topic: %w", err)
+	}
+
+	b.metric.IncrementTotalUnprocessedMessagesCounter(int64(len(messages)))
+	return nil
 }
 
