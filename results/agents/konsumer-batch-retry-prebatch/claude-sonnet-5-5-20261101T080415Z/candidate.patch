+		}
+		if deadLetterErr == nil {
+			deadLetterErr = failureOf(msg)
+		}
+		msg.AddHeader(Header{
+			Key:   errMessageKey,
+			Value: []byte(getErrorMessage(consumeErr, msg)),
+		})
+		msg.Topic = "" // we set on initialize for dead letter producer
+		deadLetterMessages = append(deadLetterMessages, *msg)
+	}
+
+	if len(deadLetterMessages) > 0 {
+		if b.deadLetterProducer == nil || b.sendToDeadLetterWithBackoff(deadLetterMessages...) != nil {
+			// nothing is lost: let the message follow the normal retry flow
+			if retryErr == nil {
+				retryErr = deadLetterErr
+			}
+		}
+	}
+
+	return retryErr
