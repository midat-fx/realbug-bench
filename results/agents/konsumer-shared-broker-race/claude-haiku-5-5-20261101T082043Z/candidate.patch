+// Allocates a new slice: the input may be shared with a running kafka-go reader.
+func trimBrokerAddresses(brokers []string) []string {
+	trimmed := make([]string, len(brokers))
+	for i, broker := range brokers {
+		trimmed[i] = strings.TrimSpace(broker)
 	}
+	return trimmed
