+
+// trimBrokerList returns a private, whitespace-trimmed copy of brokers.
+//
+// Kafka readers can access their broker slice from background goroutines, so
+// constructors must not reuse a caller-owned slice when normalizing addresses.
+func trimBrokerList(brokers []string) []string {
+	if brokers == nil {
+		return nil
 	}
+
+	trimmed := make([]string, len(brokers))
+	for i := range brokers {
+		trimmed[i] = strings.TrimSpace(brokers[i])
+	}
+
+	return trimmed
 }
 
