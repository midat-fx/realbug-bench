+/**
+ * Find the next token that contributes output, skipping empty text tokens.
+ */
+function nextToken(tokens: Token[], index: number): Token | undefined {
+  while (index < tokens.length) {
+    const token = tokens[index++];
+    if (token.type !== "text" || token.value !== "") return token;
+  }
+}
