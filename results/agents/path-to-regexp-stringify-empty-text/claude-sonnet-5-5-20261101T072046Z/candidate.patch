+  describe("stringify empty text tokens", () => {
+    it("should quote names followed by empty text then identifier text", () => {
+      const data = new TokenData([
+        { type: "text", value: "/" },
+        { type: "param", name: "foo" },
+        { type: "text", value: "" },
+        { type: "text", value: "bar" },
