diff --git a/pq/message/truncated_test.go b/pq/message/truncated_test.go
new file mode 100644
index 0000000..2c30752
--- /dev/null
+++ b/pq/message/truncated_test.go
@@ -0,0 +1,222 @@
+package message
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+	"time"
+
+	"github.com/Trendyol/go-pq-cdc/pq/message/format"
+	"github.com/Trendyol/go-pq-cdc/pq/message/tuple"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const truncationOID = 16390
+
+func u16(v uint16) []byte { return binary.BigEndian.AppendUint16(nil, v) }
+func u32(v uint32) []byte { return binary.BigEndian.AppendUint32(nil, v) }
+func u64(v uint64) []byte { return binary.BigEndian.AppendUint64(nil, v) }
+
+func join(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+
+func truncationRelations() map[uint32]*format.Relation {
+	return map[uint32]*format.Relation{
+		truncationOID: {
+			OID:       truncationOID,
+			Namespace: "public",
+			Name:      "t",
+			Columns: []tuple.RelationColumn{
+				{Name: "id", DataType: 23},
+				{Name: "v", DataType: 25},
+			},
+		},
+	}
+}
+
+func relationBody() []byte {
+	return join(
+		u32(truncationOID),
+		[]byte("public\x00t\x00d"),
+		u16(2),
+		[]byte{0}, []byte("id\x00"), u32(23), u32(0xffffffff),
+		[]byte{0}, []byte("v\x00"), u32(25), u32(0xffffffff),
+	)
+}
+
+type truncationFixture struct {
+	name     string
+	data     []byte
+	streamed bool
+}
+
+func truncationFixtures() []truncationFixture {
+	return []truncationFixture{
+		{
+			name: "begin",
+			data: join([]byte{'B'}, u64(1), u64(2), u32(3)),
+		},
+		{
+			name: "commit",
+			data: join([]byte{'C', 0}, u64(1), u64(2), u64(3)),
+		},
+		{
+			name: "relation",
+			data: join([]byte{'R'}, relationBody()),
+		},
+		{
+			name:     "streamed relation",
+			data:     join([]byte{'R'}, u32(7), relationBody()),
+			streamed: true,
+		},
+		{
+			name: "insert",
+			data: join([]byte{'I'}, u32(truncationOID), []byte{'N'}, u16(2),
+				[]byte{'t'}, u32(3), []byte("123"),
+				[]byte{'t'}, u32(1), []byte("x"),
+			),
+		},
+		{
+			name: "streamed insert",
+			data: join([]byte{'I'}, u32(7), u32(truncationOID), []byte{'N'}, u16(2),
+				[]byte{'t'}, u32(3), []byte("123"),
+				[]byte{'n'},
+			),
+			streamed: true,
+		},
+		{
+			name: "update with old tuple and toast column",
+			data: join([]byte{'U'}, u32(truncationOID), []byte{'O'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("1"),
+				[]byte{'t'}, u32(1), []byte("a"),
+				[]byte{'N'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("2"),
+				[]byte{'u'},
+			),
+		},
+		{
+			name: "update with key tuple",
+			data: join([]byte{'U'}, u32(truncationOID), []byte{'K'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("1"),
+				[]byte{'n'},
+				[]byte{'N'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("2"),
+				[]byte{'n'},
+			),
+		},
+		{
+			name: "update without old tuple",
+			data: join([]byte{'U'}, u32(truncationOID), []byte{'N'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("2"),
+				[]byte{'n'},
+			),
+		},
+		{
+			name: "streamed update",
+			data: join([]byte{'U'}, u32(7), u32(truncationOID), []byte{'N'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("2"),
+				[]byte{'n'},
+			),
+			streamed: true,
+		},
+		{
+			name: "delete",
+			data: join([]byte{'D'}, u32(truncationOID), []byte{'K'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("1"),
+				[]byte{'n'},
+			),
+		},
+		{
+			name: "streamed delete",
+			data: join([]byte{'D'}, u32(7), u32(truncationOID), []byte{'O'}, u16(2),
+				[]byte{'t'}, u32(1), []byte("1"),
+				[]byte{'n'},
+			),
+			streamed: true,
+		},
+		{
+			name: "truncate",
+			data: join([]byte{'T'}, u32(1), []byte{1}, u32(truncationOID)),
+		},
+		{
+			name:     "streamed truncate",
+			data:     join([]byte{'T'}, u32(7), u32(1), []byte{1}, u32(truncationOID)),
+			streamed: true,
+		},
+		{
+			name: "stream start",
+			data: join([]byte{'S'}, u32(5), []byte{1}),
+		},
+		{
+			name: "stream abort",
+			data: join([]byte{'A'}, u32(5), u32(6)),
+		},
+		{
+			name: "stream commit",
+			data: join([]byte{'c'}, u32(5), []byte{0}, u64(1), u64(2), u64(3)),
+		},
+	}
+}
+
+func TestNewReturnsErrorForEveryTruncatedMessage(t *testing.T) {
+	for _, fixture := range truncationFixtures() {
+		t.Run(fixture.name, func(t *testing.T) {
+			full := fixture.data
+			_, err := New(full, fixture.streamed, time.Now(), truncationRelations())
+			require.NoError(t, err)
+
+			for i := 0; i < len(full); i++ {
+				relations := truncationRelations()
+				var err error
+				assert.NotPanics(t, func() {
+					_, err = New(full[:i], fixture.streamed, time.Now(), relations)
+				}, "prefix length %d", i)
+				assert.Error(t, err, "prefix length %d", i)
+			}
+		})
+	}
+}
+
+func TestNewDoesNotCacheTruncatedRelation(t *testing.T) {
+	full := join([]byte{'R'}, relationBody())
+
+	for i := 1; i < len(full); i++ {
+		relations := map[uint32]*format.Relation{}
+		_, err := New(full[:i], false, time.Now(), relations)
+		require.Error(t, err, "prefix length %d", i)
+		assert.Empty(t, relations, "prefix length %d", i)
+	}
+}
+
+func TestNewRejectsTupleWiderThanRelation(t *testing.T) {
+	relations := map[uint32]*format.Relation{
+		truncationOID: {
+			OID:     truncationOID,
+			Columns: []tuple.RelationColumn{{Name: "id", DataType: 23}},
+		},
+	}
+	data := join([]byte{'I'}, u32(truncationOID), []byte{'N'}, u16(2),
+		[]byte{'t'}, u32(1), []byte("1"),
+		[]byte{'n'},
+	)
+
+	assert.NotPanics(t, func() {
+		_, err := New(data, false, time.Now(), relations)
+		require.Error(t, err)
+	})
+}
+
+func TestNewRejectsToastColumnMissingFromOldTuple(t *testing.T) {
+	relations := truncationRelations()
+	data := join([]byte{'U'}, u32(truncationOID), []byte{'O'}, u16(1),
+		[]byte{'t'}, u32(1), []byte("1"),
+		[]byte{'N'}, u16(2),
+		[]byte{'t'}, u32(1), []byte("2"),
+		[]byte{'u'},
+	)
+
+	assert.NotPanics(t, func() {
+		_, err := New(data, false, time.Now(), relations)
+		require.Error(t, err)
+	})
+}
