+++ b/pq/message/truncated_test.go
@@ -0,0 +1,225 @@
+package message
+
+import (
+	"maps"
+	"testing"
+	"time"
+
+	"github.com/Trendyol/go-pq-cdc/pq/message/format"
+	"github.com/Trendyol/go-pq-cdc/pq/message/tuple"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type truncationSample struct {
+	name     string
+	data     []byte
+	streamed bool
+}
+
+func truncationRelations() map[uint32]*format.Relation {
+	twoColumns := []tuple.RelationColumn{
+		{Name: "id", DataType: 23, TypeModifier: 0xFFFFFFFF, Flags: 1},
+		{Name: "name", DataType: 25, TypeModifier: 0xFFFFFFFF},
+	}
+	return map[uint32]*format.Relation{
+		16390: {OID: 16390, Namespace: "public", Name: "t", Columns: twoColumns},
+		16391: {OID: 16391, Namespace: "public", Name: "u", Columns: twoColumns},
+	}
+}
+
+func truncationSamples() []truncationSample {
+	return []truncationSample{
+		{name: "begin", data: []byte{
+			'B',
+			0, 0, 0, 0, 1, 150, 157, 24,
+			0, 2, 234, 4, 120, 77, 196, 132,
+			0, 0, 2, 249,
+		}},
+		{name: "commit", data: []byte{
+			'C',
+			0,
+			0, 0, 0, 0, 1, 150, 157, 24,
+			0, 0, 0, 0, 1, 150, 157, 72,
+			0, 2, 234, 4, 120, 77, 196, 132,
+		}},
+		{name: "relation", data: []byte{
+			'R',
+			0, 0, 64, 6,
+			'p', 'u', 'b', 'l', 'i', 'c', 0,
+			't', 0,
+			'd',
+			0, 2,
+			1, 'i', 'd', 0, 0, 0, 0, 23, 255, 255, 255, 255,
+			0, 'n', 'a', 'm', 'e', 0, 0, 0, 0, 25, 255, 255, 255, 255,
+		}},
+		{name: "streamed relation", streamed: true, data: []byte{
+			'R',
+			0, 0, 4, 210,
+			0, 0, 64, 6,
+			'p', 'u', 'b', 'l', 'i', 'c', 0,
+			't', 0,
+			'd',
+			0, 1,
+			1, 'i', 'd', 0, 0, 0, 0, 23, 255, 255, 255, 255,
+		}},
+		{name: "insert", data: []byte{
+			'I',
+			0, 0, 64, 6,
+			'N',
+			0, 2,
+			't', 0, 0, 0, 2, '5', '3',
+			'n',
+		}},
+		{name: "streamed insert", streamed: true, data: []byte{
+			'I',
+			0, 0, 4, 210,
+			0, 0, 64, 6,
+			'N',
+			0, 2,
+			't', 0, 0, 0, 2, '5', '3',
+			'n',
+		}},
+		{name: "update with old tuple", data: []byte{
+			'U',
+			0, 0, 64, 6,
+			'O',
+			0, 2,
+			't', 0, 0, 0, 2, '5', '3',
+			'n',
+			'N',
+			0, 2,
+			't', 0, 0, 0, 2, '5', '3',
+			'u',
+		}},
+		{name: "update with key tuple", data: []byte{
+			'U',
+			0, 0, 64, 6,
+			'K',
+			0, 1,
+			't', 0, 0, 0, 2, '5', '3',
+			'N',
+			0, 2,
+			't', 0, 0, 0, 2, '5', '3',
+			't', 0, 0, 0, 3, 'b', 'a', 'z',
+		}},
+		{name: "delete", data: []byte{
+			'D',
+			0, 0, 64, 6,
+			'K',
+			0, 2,
+			't', 0, 0, 0, 2, '5', '3',
+			'n',
+		}},
+		{name: "truncate", data: []byte{
+			'T',
+			0, 0, 0, 2,
+			3,
+			0, 0, 64, 6,
+			0, 0, 64, 7,
+		}},
+		{name: "streamed truncate", streamed: true, data: []byte{
+			'T',
+			0, 0, 4, 210,
+			0, 0, 0, 1,
+			0,
+			0, 0, 64, 6,
+		}},
+		{name: "stream start", data: []byte{'S', 0, 0, 4, 210, 1}},
+		{name: "stream stop", data: []byte{'E'}},
+		{name: "stream abort", data: []byte{'A', 0, 0, 4, 210, 0, 0, 0, 5}},
+		{name: "stream commit", data: []byte{
+			'c',
+			0, 0, 4, 210,
+			0,
+			0, 0, 0, 0, 1, 150, 157, 24,
+			0, 0, 0, 0, 1, 150, 157, 72,
+			0, 2, 234, 4, 120, 77, 196, 132,
+		}},
+	}
+}
+
+func TestNewSamplesDecodeWhenComplete(t *testing.T) {
+	for _, sample := range truncationSamples() {
+		t.Run(sample.name, func(t *testing.T) {
+			msg, err := New(sample.data, sample.streamed, time.Now(), truncationRelations())
+
+			require.NoError(t, err)
+			assert.NotNil(t, msg)
+		})
+	}
+}
+
+func TestNewRejectsTruncatedMessagesWithoutPanic(t *testing.T) {
+	for _, sample := range truncationSamples() {
+		t.Run(sample.name, func(t *testing.T) {
+			for n := range len(sample.data) {
+				relations := truncationRelations()
+				before := maps.Clone(relations)
+
+				var (
+					msg any
+					err error
+				)
+				require.NotPanics(t, func() {
+					msg, err = New(sample.data[:n], sample.streamed, time.Now(), relations)
+				}, "prefix of length %d", n)
+
+				assert.Error(t, err, "prefix of length %d", n)
+				assert.Nil(t, msg, "prefix of length %d", n)
+				assert.Equal(t, before, relations, "prefix of length %d must not change relation cache", n)
+			}
+		})
+	}
+}
+
+func TestNewRejectsEmptyDataWithoutPanic(t *testing.T) {
+	require.NotPanics(t, func() {
+		_, err := New(nil, false, time.Now(), map[uint32]*format.Relation{})
+		require.Error(t, err)
+	})
+}
+
+func TestNewRejectsUpdateWhenOldTupleHasFewerColumnsThanToastedNewColumn(t *testing.T) {
+	data := []byte{
+		'U',
+		0, 0, 64, 6,
+		'O',
+		0, 1,
+		't', 0, 0, 0, 2, '5', '3',
+		'N',
+		0, 2,
+		't', 0, 0, 0, 2, '5', '3',
+		'u',
+	}
+
+	var err error
+	require.NotPanics(t, func() {
+		_, err = New(data, false, time.Now(), truncationRelations())
+	})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "old tuple has 1 columns")
+}
+
+func TestNewRejectsTupleWiderThanRelation(t *testing.T) {
+	relations := map[uint32]*format.Relation{
+		16390: {OID: 16390, Namespace: "public", Name: "t", Columns: []tuple.RelationColumn{
+			{Name: "id", DataType: 23},
+		}},
+	}
+	data := []byte{
+		'I',
+		0, 0, 64, 6,
+		'N',
+		0, 2,
+		't', 0, 0, 0, 2, '5', '3',
+		'n',
+	}
+
+	var err error
+	require.NotPanics(t, func() {
+		_, err = New(data, false, time.Now(), relations)
+	})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "relation has 1")
+}
