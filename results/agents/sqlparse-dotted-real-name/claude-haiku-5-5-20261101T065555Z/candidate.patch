@@ -0,0 +1,34 @@
+import pytest
+
+import sqlparse
+
+
+@pytest.mark.parametrize('sql, expected', [
+    ('"a"."b"."c"', 'c'),
+    ('`a`.`b`.`c`', 'c'),
+    ('[a].[b].[c]', '[c]'),
+    ('"a"."b"."c" x', 'c'),
+    ('warehouse.sales.orders', 'orders'),
+    ('server.db.dbo.table', 'table'),
+])
+def test_real_name_is_last_component(sql, expected):
+    ident = sqlparse.parse(sql)[0].tokens[0]
+    assert ident.get_real_name() == expected
+
+
+def test_real_name_of_qualified_function_call():
+    ident = sqlparse.parse('db.schema.fn(1)')[0].tokens[0]
+    assert ident.get_real_name() == 'fn'
+
+
+def test_parent_name_stays_first_component():
+    ident = sqlparse.parse('server.db.dbo.table')[0].tokens[0]
+    assert ident.get_parent_name() == 'server'
+
+
+def test_alias_of_three_part_name_in_select():
+    stmt = sqlparse.parse('select o.id from db.schema.orders o')[0]
+    ident = stmt.tokens[-1]
+    assert ident.get_real_name() == 'orders'
+    assert ident.get_alias() == 'o'
+    assert ident.get_name() == 'o'
