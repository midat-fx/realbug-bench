+++ b/tests/doc/flow-key-comment.ts
@@ -0,0 +1,44 @@
+import * as YAML from 'yaml'
+import { _map, _seq } from '../_utils.ts'
+
+describe('flow collection key after a comment or nested blank line', () => {
+  test('flow sequence key after a comment line', () => {
+    const doc = YAML.parseDocument('1: 2\n# note\n[3]: 4')
+    expect(doc.errors).toHaveLength(0)
+    expect(doc.value).toMatchObject(
+      _map([
+        [1, 2],
+        [_seq(3), 4]
+      ])
+    )
+    expect(String(doc)).toContain('# note')
+  })
+
+  test('flow mapping key after a blank line', () => {
+    const doc = YAML.parseDocument('1: 2\n\n{a: 1}: x')
+    expect(doc.errors).toHaveLength(0)
+    expect(doc.toJS({ mapAsMap: true })).toMatchObject(
+      new Map<unknown, unknown>([
+        [1, 2],
+        [new Map([['a', 1]]), 'x']
+      ])
+    )
+  })
+
+  test('flow key in a nested block map after a blank line', () => {
+    const doc = YAML.parseDocument('a:\n  1: 2\n\n  [3]: 4\n  5: 6\n')
+    expect(doc.errors).toHaveLength(0)
+    expect(doc.toJS({ mapAsMap: true })).toMatchObject(
+      new Map<unknown, unknown>([
+        [
+          'a',
+          new Map<unknown, unknown>([
+            [1, 2],
+            [[3], 4],
+            [5, 6]
+          ])
+        ]
+      ])
+    )
+  })
+})
