+
+describe('flow collection key after blank line or comment', () => {
+  for (const [src, comment] of [
+    ['1: 2\n\n[3]: 4', ''],
+    ['1: 2\n# note\n[3]: 4', '# note'],
+    ['a:\n  1: 2\n\n  {a: 1}: x\n  z: 1\n', ''],
+    ['- 1: 2\n  # note\n  [3]: 4\n', '# note']
+  ]) {
+    test(JSON.stringify(src), () => {
+      const doc = YAML.parseDocument(src)
+      expect(doc.errors).toHaveLength(0)
+      expect(String(doc)).toContain(comment)
+    })
+  }
+})
