# Source of truth for this task. Read by harness/grade.sh (inside the container) and by ./bench.
TASK_ID=immer-revoked-mapset-reads
LANGUAGE=typescript
UPSTREAM=https://github.com/immerjs/immer
BASE_COMMIT=02e87e7b96d0e12ba223203cc66e8fad4049c482
FIX_COMMIT=8848a5b16938e5681a890d73de7bda24b5080498
# Test files (and snapshots) and the test/type-check configuration: candidate changes to these are discarded.
TEST_FILE_RE='(^__tests__/|(^|/)vite(st)?\.config\.|^tsconfig[^/]*\.json$|^package\.json$|^yarn\.lock$)'
# --skipLibCheck: the repository's @types/node does not type-check under its own "module": "ES6" setting.
BUILD_CMD="npx tsc --noEmit -p tsconfig.json --skipLibCheck"
VISIBLE_CMD="npx vitest run __tests__/revoked-map-set.js"
HIDDEN_CMD="npx vitest run __tests__/zz-hidden-revoked-map-set.js"
REGRESSION_CMD="npx vitest run"
