diff --git a/batch_consumer.go b/batch_consumer.go
index ace2a2d..7fc26b5 100644
--- a/batch_consumer.go
+++ b/batch_consumer.go
@@ -62,11 +62,25 @@ func newBatchConsumer(cfg *ConsumerConfig) (Consumer, error) {
 
 func (b *batchConsumer) runKonsumerFn(message kcronsumer.Message) error {
 	msgList := []*Message{toMessage(message)}
+	if b.preBatchFn != nil {
+		if msgList = b.preBatchFn(msgList); len(msgList) == 0 {
+			return nil
+		}
+	}
 
 	err := b.consumeFn(msgList)
 	if msgList[0].ErrDescription != "" {
 		err = errors.New(msgList[0].ErrDescription)
 	}
+	if err != nil && msgList[0].SendDirectToDeadLetter {
+		if b.deadLetterProducer != nil {
+			m := msgList[0]
+			m.AddHeader(Header{Key: errMessageKey, Value: []byte(getErrorMessage(err, m))})
+			m.Topic = ""
+			_ = b.sendToDeadLetterWithBackoff(*m)
+		}
+		return nil
+	}
 	return err
 }
 
