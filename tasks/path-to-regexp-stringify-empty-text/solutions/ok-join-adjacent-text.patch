+/**
+ * Join adjacent text tokens. Text can be split across tokens (or be empty), and
+ * the check for a name running into the following text must see what actually
+ * follows the name.
+ */
+function joinText(tokens: Token[]): Token[] {
+  const result: Token[] = [];
+  for (const token of tokens) {
+    const last = result[result.length - 1];
+    if (token.type === "text" && last?.type === "text") {
+      result[result.length - 1] = { type: "text", value: last.value + token.value };
+    } else {
+      result.push(token);
+    }
+  }
+  return result;
+}
