# Source of truth for this task. Read by harness/grade.sh (inside the container) and by ./bench.
TASK_ID=path-to-regexp-stringify-empty-text
LANGUAGE=typescript
UPSTREAM=https://github.com/pillarjs/path-to-regexp
BASE_COMMIT=8877f41873e37a30258d3935feaf1d2679321735
FIX_COMMIT=7dd6f8f7bd63ae8bffca0968144508228dc61729
# Test files and the test/type-check configuration: candidate changes to these are discarded.
TEST_FILE_RE='(\.spec\.ts$|\.test\.ts$|(^|/)vite(st)?\.config\.|^tsconfig[^/]*\.json$|^package(-lock)?\.json$)'
BUILD_CMD="npx tsc --noEmit -p tsconfig.json"
VISIBLE_CMD="npx vitest run src/stringify-empty-text.spec.ts"
HIDDEN_CMD="npx vitest run src/zz-hidden-stringify-empty-text.spec.ts"
# Upstream suite: src/index.spec.ts (all parse/compile/match/stringify cases). src/redos.spec.ts is left out:
# it runs the recheck ReDoS analyser, whose native binary exists only for linux-x64 and macOS arm64.
REGRESSION_CMD="npx vitest run src/index.spec.ts"
