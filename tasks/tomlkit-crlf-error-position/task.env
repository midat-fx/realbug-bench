# Source of truth for this task. Read by harness/grade.sh (inside the container) and by ./bench.
TASK_ID=tomlkit-crlf-error-position
LANGUAGE=python
UPSTREAM=https://github.com/python-poetry/tomlkit
BASE_COMMIT=8c30fc17d91aee7469c0287e509300e78aa15227
FIX_COMMIT=c07c0c15c49a893bb8a4c9f63401822d31e08942
# tests/toml-test is a submodule (the regression suite needs it); ./bench workspace checks it out too.
SUBMODULES="tests/toml-test"
# Test files, conftest and test-runner configuration: candidate changes to these are discarded.
TEST_FILE_RE='(^tests/|(^|/)conftest\.py$|^pyproject\.toml$|^setup\.cfg$|^tox\.ini$|^pytest\.ini$)'
PYTEST="python -m pytest -q -p no:cacheprovider"
BUILD_CMD="python -m compileall -q tomlkit && python -c 'import tomlkit'"
VISIBLE_CMD="$PYTEST tests/test_crlf_positions.py"
HIDDEN_CMD="$PYTEST tests/test_zz_hidden_crlf_positions.py"
REGRESSION_CMD="$PYTEST tests"
