# The yaml-test-suite and JSONTestSuite submodules are part of the regression suite.
SUBMODULES="tests/yaml-test-suite tests/json-test-suite"
# Test files and the test/type-check configuration: candidate changes to these are discarded.
TEST_FILE_RE='(^tests/|(^|/)vite(st)?\.config\.|^tsconfig[^/]*\.json$|^package(-lock)?\.json$)'
BUILD_CMD="npx tsc --noEmit"
VISIBLE_CMD="npx vitest run tests/doc/flow-key-blank-line.ts"
HIDDEN_CMD="npx vitest run tests/doc/zz-hidden-flow-key.ts"
REGRESSION_CMD="npx vitest run"
