# Source of truth for this task. Read by harness/grade.sh (inside the container) and by ./bench.
TASK_ID=yaml-flow-key-after-blank-line
LANGUAGE=typescript
UPSTREAM=https://github.com/eemeli/yaml
BASE_COMMIT=4ecbf764b11605e8e62ee3596f18b0a4f0f78c88
